# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
fuscan-core-wheels/
*.egg-info

# Virtual environments
.venv

# Rust 编译产物（fuscan-core PyO3 扩展）
# 防止 hatchling sdist 把 500MB+ 的 target/ 打入源码包
packages/fuscan-core/target/
packages/fuscan-core/dist/
packages/fuscan-core/.venv*

# 测试与覆盖率
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
.tox/
.benchmarks/

# 工具缓存
.ruff_cache/
.pyrefly_cache/
.mypy_cache/
.uv-cache/

# IDE
.idea/
*_profile.html

# 环境变量与凭证（勿提交）
.env
.env.*

# Sphinx 文档构建输出
docs/_build/
.trae/ref

# OCR 模型文件（PP-OCRv4 mobile，约 17MB，不入仓）
# 由打包脚本/CI 从 RapidOCR Release 下载到 src/fuscan/assets/ocr/models/
# 本地开发可用占位文件（hatchling force-include 需文件存在），真实模型下载后替换
src/fuscan/assets/ocr/models/*.onnx
src/fuscan/assets/ocr/models/ppocr_keys_v1.txt