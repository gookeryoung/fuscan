packages/fuscan-core/target/
packages/fuscan-core/dist/
packages/fuscan-core/.venv*

# 测试与覆盖率
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
.tox/
.benchmarks/

# 工具缓存
.ruff_cache/
.pyrefly_cache/
.mypy_cache/
.uv-cache/

# IDE
.idea/
*_profile.html

# 环境变量与凭证（勿提交）
.env
.env.*

# Sphinx 文档构建输出
docs/_build/
.trae/ref

# OCR 引擎与模型文件随软件内置入仓（约 30MB 合计）：
# RapidOCR-json 预编译 exe（16MB，C++ 静态链接 onnxruntime+opencv，兼容 Win7）
# + PP-OCRv3 简中模型（det/cls/rec + keys，约 14MB）
# 仅 Windows 可执行；Linux 便携包含但运行时不可用（is_ocr_available 平台门禁拦截）